#!/bin/bash
# Detect OS without relying on GNU-only uname -o.
case "$(uname -s)" in
  Linux) ostype=linux ;;
  Darwin) ostype=darwin ;;
  *) echo "Unsupported OS" >&2; exit 1 ;;
esac
case "${ostype}" in
  android|linux)
    export MI_ABSPATH_GETTER="readlink -m"
    export MI_ECHO_ASCII_CHARA="echo -e"
    ;;
  darwin)
    export MI_ABSPATH_GETTER="readlink -f"
    export MI_ECHO_ASCII_CHARA="echo"
    ;;
  *)
    echo "Cannot detect os type"
    exit 1
esac

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

source "${here}/modules/message.sh"

if [ "${1:-}" = sweep ]; then
  exec bash "${here}/modules/sweep.sh"
fi

# Selected packages are copied to the requested HOME, not linked to this checkout.
# Avoid an inherited XDG_CONFIG_HOME pointing back to the invoking host.
if [[ "${1:-}" == deploy && -n "${MI_PACKAGES:-}" ]]; then
  if [[ "${MI_PROFILE:-host}" != container ]]; then
    # The host account's actual HOME must never be changed from links to copies.
    account_home=""
    if command -v getent >/dev/null 2>&1; then
      account_entry="$(getent passwd "$(id -u)")" || {
        red "Cannot determine account HOME; refusing targeted host deployment."
        exit 1
      }
      account_home="$(cut -d: -f6 <<< "$account_entry")"
    elif [[ "$ostype" == darwin ]] && command -v dscl >/dev/null 2>&1; then
      account_home="$(dscl . -read "/Users/$(id -un)" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
    fi
    if [[ -z "$account_home" ]]; then
      red "Cannot determine account HOME; refusing targeted host deployment."
      exit 1
    fi
    if [[ "$ostype" == linux ]]; then
      target_home="$(readlink -m -- "$HOME")" || exit 1
      actual_home="$(readlink -m -- "$account_home")" || exit 1
    else
      target_home="$(realpath "$HOME")" || exit 1
      actual_home="$(realpath "$account_home")" || exit 1
    fi
    if [[ "$target_home" == "$actual_home" ]]; then
      red "MI_PACKAGES would copy settings into the host HOME. Set HOME to a separate destination."
      exit 1
    fi
  fi
  export MI_DEPLOY_MODE=copy
  export XDG_CONFIG_HOME="$HOME/.config"
fi

bash "${here}/modules/prepare.sh" || exit 1

if [ "${MI_PROFILE:-host}" = container ]; then
  export MI_DEPLOY_MODE="${MI_DEPLOY_MODE:-copy}"
  if [ "${1:-}" != deploy ]; then
    red "Container profile supports deploy only; package management is disabled."
    exit 1
  fi
fi

distro="${DISTRO:-autodetect}"

if [ "$distro" = autodetect ]; then
  if [ "$ostype" = darwin ]; then
    distro=macos
  elif [ -r /etc/os-release ]; then
    # ID and ID_LIKE are machine-readable; NAME is a display label.
    distro="$(. /etc/os-release; printf '%s %s' "${ID:-}" "${ID_LIKE:-}")"
  else
    red "Cannot detect OS distribution."
    exit 1
  fi
fi

cmd=""

case "${distro}" in
  *arch*) cmd="${here}/distro/arch.sh";;
  *macos*) cmd="${here}/distro/macos.sh";;
  *debian*|*ubuntu*) cmd="${here}/distro/debian.sh";;
  *)
    red "No definition for ${distro}."
    exit 1
    ;;
esac

if [ -z "${cmd}" ]; then
  red "Unknown distro ${distro}"
  exit 1
fi

bash "${cmd}" "$@"
status=$?
unset MI_ABSPATH_GETTER
unset MI_ECHO_ASCII_CHARA
exit "$status"
