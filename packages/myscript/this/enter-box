#!/usr/bin/env bash
set -euo pipefail

# Find the nearest Boxkit project without changing the caller's directory.
here="$(pwd -P)"
root="$here"
while [[ "$root" != / ]]; do
  if [[ -f "$root/boxkit.ini" && -f "$root/box" ]]; then
    relative="${here#"$root"}"
    relative="${relative#/}"
    workdir=/workspace
    [[ -z "$relative" ]] || workdir="/workspace/$relative"
    exec "$root/box" e --workdir "$workdir"
  fi
  root="$(dirname -- "$root")"
done

printf '%s\n' 'box cannot be found'
