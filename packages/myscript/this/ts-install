#!/bin/bash

DB_FILE="${TS_INSTALL_DB_FILE:-$HOME/.local/state/treesitter-installed.txt}"
DEST_DIR="${TS_INSTALL_PARSER_DIR:-$HOME/.local/share/nvim/site/parser}"
QUERY_DIR="${TS_INSTALL_QUERY_DIR:-$HOME/.local/share/nvim/site/queries}"
CMD_NAME=$(basename "$0")

mkdir -p "$(dirname "$DB_FILE")"
mkdir -p "$DEST_DIR"
mkdir -p "$QUERY_DIR"

function usage()
{
  echo "Usage:"
  echo "  $CMD_NAME <lang> [url] : Install or update (parser & queries)"
  echo "  $CMD_NAME rm <lang>    : Uninstall parser, queries and set status to 'n'"
  echo "  $CMD_NAME ls           : List all languages in DB"
  echo "  $CMD_NAME              : Update all installed languages (status 'y')"
}

function update_db_status() {
  local lang=$1
  local url=$2
  local status=$3

  if grep -q "^$lang," "$DB_FILE" 2>/dev/null; then
    sed -i "s|^$lang,.*|$lang,$url,$status|" "$DB_FILE"
  else
    echo "$lang,$url,$status" >> "$DB_FILE"
  fi
}

function build_parser()
{
  local requested_lang=$1
  local lang=${requested_lang//-/_}
  local url=$2
  if [[ ! "$lang" =~ ^[a-zA-Z0-9_]+$ ]]; then
    echo "[$lang] Error: Invalid language name"
    return 1
  fi
  local tmp_dir=$(mktemp -d)
  local -a obj_files=()
  local linker="cc"
  local log_prefix="[$lang]"

  if ! git clone --depth 1 "$url" "$tmp_dir" &> /dev/null; then
    echo "$log_prefix Error: Failed to clone"
    rm -rf "$tmp_dir"
    return 1
  fi

  # Repositories can contain multiple grammars. Match the generated export
  # instead of taking whichever parser.c happens to be returned first.
  local symbol="tree_sitter_${lang}"
  local parser_c=""
  local candidate
  while IFS= read -r candidate; do
    if grep -Eq "${symbol}[[:space:]]*\\(" "$candidate"; then
      if [ -n "$parser_c" ]; then
        echo "$log_prefix Error: Multiple parsers export $symbol"
        rm -rf "$tmp_dir"
        return 1
      fi
      parser_c=$candidate
    fi
  done < <(find "$tmp_dir" -type f -name "parser.c" -print)

  if [ -z "$parser_c" ]; then
    echo "$log_prefix Error: No parser exporting $symbol was found"
    echo "$log_prefix Available languages:"
    find "$tmp_dir" -type f -name "parser.c" -exec \
      sed -n 's/.*tree_sitter_\([a-zA-Z0-9_]*\)[[:space:]]*(.*/  \1/p' {} + | sort -u
    rm -rf "$tmp_dir"
    return 1
  fi

  local src_dir=$(dirname "$parser_c")
  if ! cc -O3 -fPIC -I"$src_dir" -c "$parser_c" -o "$tmp_dir/parser.o"; then
    echo "$log_prefix Error: Failed to compile parser.c"
    rm -rf "$tmp_dir"
    return 1
  fi
  obj_files+=("$tmp_dir/parser.o")

  if [ -f "$src_dir/scanner.c" ]; then
    if ! cc -O3 -fPIC -I"$src_dir" -c "$src_dir/scanner.c" -o "$tmp_dir/scanner.o"; then
      echo "$log_prefix Error: Failed to compile scanner.c"
      rm -rf "$tmp_dir"
      return 1
    fi
    obj_files+=("$tmp_dir/scanner.o")
  elif [ -f "$src_dir/scanner.cc" ]; then
    if ! c++ -O3 -fPIC -I"$src_dir" -c "$src_dir/scanner.cc" -o "$tmp_dir/scanner.o"; then
      echo "$log_prefix Error: Failed to compile scanner.cc"
      rm -rf "$tmp_dir"
      return 1
    fi
    obj_files+=("$tmp_dir/scanner.o")
    linker="c++"
  fi

  local built_parser="$tmp_dir/$lang.so"
  if ! "$linker" -shared -fPIC "${obj_files[@]}" -o "$built_parser"; then
    echo "$log_prefix Error: Build failed"
    rm -rf "$tmp_dir"
    return 1
  fi

  # Install only queries belonging to the selected grammar.
  local grammar_root=$(dirname "$src_dir")
  local repo_query_dir="$grammar_root/queries"
  if [ ! -d "$repo_query_dir" ] && [ -d "$tmp_dir/queries" ]; then
    repo_query_dir="$tmp_dir/queries"
  fi
  if [ -d "$repo_query_dir" ]; then
    local target_lang_query="$QUERY_DIR/$lang"
    local staged_queries=$(mktemp -d "$QUERY_DIR/.${lang}.new.XXXXXX")
    local old_queries=""
    find "$repo_query_dir" -maxdepth 1 -type f -name '*.scm' \
      -exec cp {} "$staged_queries/" \;
    if [ -e "$target_lang_query" ] || [ -L "$target_lang_query" ]; then
      old_queries="$tmp_dir/old-queries"
      mv "$target_lang_query" "$old_queries"
    fi
    if ! mv "$staged_queries" "$target_lang_query"; then
      [ -n "$old_queries" ] && mv "$old_queries" "$target_lang_query"
      echo "$log_prefix Error: Failed to install queries"
      rm -rf "$tmp_dir" "$staged_queries"
      return 1
    fi
    echo "$log_prefix Queries synced to $target_lang_query"
  else
    echo "$log_prefix Warning: No queries found for the selected grammar"
  fi

  mv "$built_parser" "$DEST_DIR/$lang.so"
  echo "$log_prefix Successfully processed"
  update_db_status "$lang" "$url" "y"
  if [ "$requested_lang" != "$lang" ]; then
    sed -i "/^${requested_lang},/d" "$DB_FILE"
  fi
  rm -rf "$tmp_dir"
  return 0
}

case "$1" in
  --help|-h)
    usage
    exit 0
    ;;
  ls)
    if [ -f "$DB_FILE" ]; then
      while IFS=',' read -r lang url status; do
        [ -z "$lang" ] && continue
        flag=" "
        [ "$status" == "y" ] && flag="✔︎"
        printf "%-12s: %s [%s]\n" "$lang" "$flag" "$url"
      done < "$DB_FILE"
    else
      echo "No records in DB."
    fi
    ;;

  rm)
    TARGET_LANG=$2
    if [ -z "$TARGET_LANG" ]; then
      usage; exit 1
    fi

    [ -f "$DEST_DIR/$TARGET_LANG.so" ] && rm "$DEST_DIR/$TARGET_LANG.so" && echo "Deleted $TARGET_LANG.so"
    [ -d "$QUERY_DIR/$TARGET_LANG" ] && rm -rf "$QUERY_DIR/$TARGET_LANG" && echo "Deleted queries for $TARGET_LANG"

    SAVED_LINE=$(grep "^$TARGET_LANG," "$DB_FILE" 2>/dev/null)
    if [ -n "$SAVED_LINE" ]; then
      URL=$(echo "$SAVED_LINE" | cut -d',' -f2)
      update_db_status "$TARGET_LANG" "$URL" "n"
      echo "Status for $TARGET_LANG set to 'n'"
    else
      echo "Warning: $TARGET_LANG not found in DB."
    fi
    ;;

  "")
    if [ ! -s "$DB_FILE" ]; then
      echo "No installed languages found."; exit 0
    fi
    echo "Updating installed parsers and queries..."
    while IFS=',' read -r lang url status; do
      [ "$status" == "y" ] && build_parser "$lang" "$url"
    done < "$DB_FILE"
    ;;

  *)
    TARGET_LANG=$1
    TARGET_URL=$2

    SAVED_LINE=$(grep "^$TARGET_LANG," "$DB_FILE" 2>/dev/null)

    if [ -n "$SAVED_LINE" ]; then
      URL=$(echo "$SAVED_LINE" | cut -d',' -f2)
      echo "Found $TARGET_LANG in DB. Processing..."
      build_parser "$TARGET_LANG" "$URL" || exit 1
    else
      if [ -z "$TARGET_URL" ]; then
        printf "Enter source URL for %s: " "$TARGET_LANG"
        read -r TARGET_URL
      fi

      if [ -z "$TARGET_URL" ]; then
        echo "Error: URL is required."; exit 1
      fi

      build_parser "$TARGET_LANG" "$TARGET_URL" || exit 1
    fi
    ;;
esac
